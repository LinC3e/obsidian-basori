{
	"name": "basori-theme",
	"version": "1.0.0",
	"scripts": {
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "stylelint \"**/*.css\"",
		"build": "sass src/scss/main.scss theme.css --style=expanded",
		"watch": "sass --watch src/scss/main.scss:theme.css --style=expanded"
	},
	"devDependencies": {
		"sass": "^1.104.0",
		"stylelint": "^17.0.0",
		"stylelint-config-obsidianmd": "^0.1.0"
	}
}